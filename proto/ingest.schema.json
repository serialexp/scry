    "SummaryPointV2": {
      "description": "Summary point with exact count, sum, and sorted quantile/value pairs.",
      "sequence": [
        {
          "name": "tag",
          "type": "uint8",
          "const": 4
        },
        {
          "name": "descriptor_id",
          "type": "uint32"
        },
        {
          "name": "start_unix_nano",
          "type": "uint64"
        },
        {
          "name": "ts_unix_nano",
          "type": "uint64"
        },
