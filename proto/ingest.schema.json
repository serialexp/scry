        {
          "name": "scope_name",
          "type": "string",
          "kind": "length_prefixed",
          "length_type": "uint8",
          "encoding": "utf8"
        },
        {
          "name": "scope_version",
          "type": "string",
          "kind": "length_prefixed",
          "length_type": "uint8",
          "encoding": "utf8"
        },
        {
          "name": "scope_attrs",
          "type": "array",
          "kind": "length_prefixed",
          "length_type": "uint16",
          "items": {
            "type": "LabelPair"
          }
        }
      ]
    },
    "MetricPointV2": {
      "description": "A tagged canonical metric point. Tag 1 scalar, 2 explicit histogram, 3 exponential/native histogram, 4 summary.",
      "sequence": [
        {
          "name": "value",
          "type": "discriminated_union",
          "discriminator": {
            "peek": "uint8"
          },
          "variants": [
            {
              "type": "ScalarPointV2",
              "when": "value === 1"
            },
            {
              "type": "HistogramPointV2",
              "when": "value === 2"
            },
            {
              "type": "ExponentialHistogramPointV2",
              "when": "value === 3"
            },
            {
              "type": "SummaryPointV2",
              "when": "value === 4"
            }
          ]
        }
      ]
    },
