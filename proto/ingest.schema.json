        {
          "name": "format",
          "type": "uint8"
        },
        {
          "name": "data",
          "type": "bytes",
          "kind": "length_prefixed",
          "length_type": "uint32"
        }
      ]
    },
    "DummyBatch": {
      "description": "Body of a Batch whose signal is Dummy (0xFF). v0.1-only placeholder used to exercise the storage pipeline before any real signal lands. Goes away when the first real signal arrives.",
      "sequence": [
        {
          "name": "records",
          "type": "array",
          "kind": "length_prefixed",
          "length_type": "uint32",
          "items": {
            "type": "DummyRecord"
          }
        }
      ]
    },
    "DummyRecord": {
      "description": "v0.1-only record type. A timestamp, an arbitrary key, and an opaque value. The storage layer treats this as the single record shape until real signals come online.",
      "sequence": [
        {
          "name": "ts_unix_nano",
          "type": "uint64"
        },
        {
          "name": "key",
          "type": "string",
          "kind": "length_prefixed",
          "length_type": "uint16",
          "encoding": "utf8"
        },
        {
          "name": "value",
          "type": "bytes",
          "kind": "length_prefixed",
          "length_type": "uint32"
        }
      ]
    },
    "MetricsBatchV2": {
      "description": "Protocol-v2 canonical structured metrics payload. Unlike MetricsBatch v1, structured values are never exploded into synthetic scalar series. A fixed magic prefix makes WAL replay and defensive decoders distinguish it from positional v1 payloads.",
      "sequence": [
        {
          "name": "magic",
          "type": "uint32",
          "const": 1397568000
        },
        {
          "name": "descriptors",
          "type": "array",
          "kind": "length_prefixed",
          "length_type": "uint32",
          "items": {
            "type": "MetricDescriptorV2"
          }
        },
        {
          "name": "points",
          "type": "array",
          "kind": "length_prefixed",
          "length_type": "uint32",
          "items": {
            "type": "MetricPointV2"
          }
        }
      ]
    },
    "MetricDescriptorV2": {
      "description": "Batch-local metric identity and common OpenTelemetry/Prometheus metadata.",
      "sequence": [
        {
          "name": "id",
          "type": "uint32"
        },
        {
          "name": "name",
          "type": "string",
          "kind": "length_prefixed",
          "length_type": "uint16",
          "encoding": "utf8"
        },
        {
          "name": "description",
          "type": "string",
          "kind": "length_prefixed",
          "length_type": "uint16",
          "encoding": "utf8"
        },
        {
          "name": "unit",
          "type": "string",
          "kind": "length_prefixed",
          "length_type": "uint16",
          "encoding": "utf8"
