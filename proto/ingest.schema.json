          "name": "tag",
          "type": "uint8",
          "const": 2
        },
        {
          "name": "value",
          "type": "float64"
        }
      ]
    },
    "SparseBucketsV2": {
      "description": "Sparse exponential histogram bucket run. Deltas are signed offsets; counts share one numeric representation.",
      "sequence": [
        {
          "name": "offset",
