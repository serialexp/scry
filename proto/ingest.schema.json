    "MetricNumberV2": {
      "description": "Lossless scalar value union.",
      "sequence": [
        {
          "name": "value",
          "type": "discriminated_union",
          "discriminator": {
            "peek": "uint8"
          },
          "variants": [
            {
              "type": "IntegerValueV2",
